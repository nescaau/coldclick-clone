# Tudo é opcional: o app roda sem nenhum .env.

# Pasta onde ficam o banco SQLite e (por padrão) os arquivos enviados/gerados.
# Padrão: ./data
# COLDCLICK_DATA_DIR=./data

# Chave mestra (32 bytes em base64) que criptografa as chaves de API no banco.
# Se ausente, é gerada na primeira execução em data/.secret.key.
# Gerar uma: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# COLDCLICK_SECRET_KEY=

# Exige Chrome pareado e online para liberar a etapa Revisão do wizard (como na plataforma original).
# Padrão desligado: na fase atual a geração é simulada e não depende da extensão.
# COLDCLICK_REQUIRE_FLOW=1

# Worker simulado: taxa de falha simulada por tentativa (0 a 1). Padrão: 0.1
# COLDCLICK_SIM_FAILURE_RATE=0.1

# Worker simulado: multiplicador de velocidade (0.1 = 10x mais rápido). Padrão: 1
# COLDCLICK_SIM_SPEED=1
