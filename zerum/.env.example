# Tudo é opcional: o Zerum roda sem nenhum .env. NÃO há login, assinatura nem chave de IA para configurar.

# Pasta do banco SQLite (zerum.db) e dos virais enviados. Padrão: ./data (dentro de zerum/)
# ZERUM_DATA_DIR=./data

# Hosts extras aceitos no cabeçalho Host (separados por vírgula). Por padrão só localhost/127.0.0.1/[::1].
# Necessário apenas se você acessar por outro nome (ex.: meu-mac.local) — e rodar com -H 0.0.0.0.
# ZERUM_ALLOWED_HOSTS=meu-mac.local

# Duração simulada de cada cena (ms) na geração SIMULADA (padrão 2500). Útil em testes/smoke.
# ZERUM_SIM_SCENE_MS=2500
